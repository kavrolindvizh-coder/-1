</footer>


<!-- =========================================
     ОКНО ВВОДА ПАРОЛЯ
========================================= -->

<div
    class="modal"
    id="passwordModal">

    <div class="modal-box">

        <div class="modal-carpet">
            🧶
        </div>

        <h2>
            Администратор
        </h2>

        <p>
            Введите пароль для редактирования сайта
        </p>


        <input
            id="passwordInput"
            class="password-input"
            type="password"
            placeholder="••••"
            autocomplete="off">


        <div class="modal-buttons">

            <button
                class="btn btn-gold"
                onclick="checkPassword()">

                ВОЙТИ

            </button>

            <button
                class="btn"
                onclick="closePasswordModal()">

                ОТМЕНА

            </button>

        </div>


        <div
            id="passwordError"
            class="error">
        </div>

    </div>

</div>


<!-- =========================================
     АДМИН-ПАНЕЛЬ
========================================= -->

<div
    class="modal"
    id="adminModal">

    <div class="admin-modal-box">


        <div class="admin-header">

            <h2>
                🧶 Редактирование KAVROLIN
            </h2>

            <button
                class="close-admin"
                onclick="closeAdmin()">

                ×

            </button>

        </div>


        <!-- ССЫЛКИ -->

        <div class="admin-section">

            <h3>
                🔗 Ссылки
            </h3>


            <div class="admin-grid">


                <div class="admin-field">

                    <label>
                        Twitch
                    </label>

                    <input
                        id="adminTwitch"
                        type="url"
                        placeholder="https://www.twitch.tv/username">

                </div>


                <div class="admin-field">

                    <label>
                        Telegram
                    </label>

                    <input
                        id="adminTelegram"
                        type="url"
                        placeholder="https://t.me/channel">

                </div>


                <div class="admin-field">

                    <label>
                        Donatello
                    </label>

                    <input
                        id="adminDonatello"
                        type="url"
                        placeholder="https://donatello.to/username">

                </div>

            </div>

        </div>


        <!-- РАСПИСАНИЕ -->

        <div class="admin-section">

            <h3>
                📅 Расписание стримов
            </h3>


            <div class="schedule-admin">


                <div class="schedule-admin-row">

                    <strong>
                        ПОНЕДЕЛЬНИК
                    </strong>

                    <input
                        id="adminMonday"
                        type="text"
                        placeholder="19:00 — 23:00">

                </div>


                <div class="schedule-admin-row">

                    <strong>
                        ВТОРНИК
                    </strong>

                    <input
                        id="adminTuesday"
                        type="text"
                        placeholder="19:00 — 23:00">

                </div>


                <div class="schedule-admin-row">

                    <strong>
                        СРЕДА
                    </strong>

                    <input
                        id="adminWednesday"
                        type="text"
                        placeholder="ВЫХОДНОЙ">

                </div>


                <div class="schedule-admin-row">

                    <strong>
                        ЧЕТВЕРГ
                    </strong>

                    <input
                        id="adminThursday"
                        type="text"
                        placeholder="19:00 — 23:00">

                </div>


                <div class="schedule-admin-row">

                    <strong>
                        ПЯТНИЦА
                    </strong>

                    <input
                        id="adminFriday"
                        type="text"
                        placeholder="20:00 — 00:00">

                </div>


                <div class="schedule-admin-row">

                    <strong>
                        СУББОТА
                    </strong>

                    <input
                        id="adminSaturday"
                        type="text"
                        placeholder="20:00 — 00:00">

                </div>


                <div class="schedule-admin-row">

                    <strong>
                        ВОСКРЕСЕНЬЕ
                    </strong>

                    <input
                        id="adminSunday"
                        type="text"
                        placeholder="ВЫХОДНОЙ">

                </div>

            </div>

        </div>


        <!-- КНОПКИ -->

        <div class="admin-actions">

            <button
                class="btn btn-gold"
                onclick="saveChanges()">

                💾 СОХРАНИТЬ

            </button>


            <button
                class="btn"
                onclick="resetSchedule()">

                ↩ СБРОСИТЬ РАСПИСАНИЕ

            </button>


            <button
                class="btn"
                onclick="closeAdmin()">

                ВЫЙТИ

            </button>

        </div>


        <div
            id="adminStatus"
            class="admin-status">
        </div>

    </div>

</div>


<script>


/* =========================================
   ПАРОЛЬ АДМИНИСТРАТОРА
========================================= */

const ADMIN_PASSWORD = "2026";


/* =========================================
   НАСТРОЙКИ ПО УМОЛЧАНИЮ
========================================= */

const defaultSettings = {

    twitch:
        "https://www.twitch.tv/",

    telegram:
        "https://t.me/",

    donatello:
        "https://donatello.to/",

    schedule: {

        "ПОНЕДЕЛЬНИК":
            "19:00 — 23:00",

        "ВТОРНИК":
            "19:00 — 23:00",

        "СРЕДА":
            "ВЫХОДНОЙ",

        "ЧЕТВЕРГ":
            "19:00 — 23:00",

        "ПЯТНИЦА":
            "20:00 — 00:00",

        "СУББОТА":
            "20:00 — 00:00",

        "ВОСКРЕСЕНЬЕ":
            "ВЫХОДНОЙ"
    }
};


/* =========================================
   ПОЛУЧИТЬ НАСТРОЙКИ
========================================= */

function getSettings() {

    const saved =
        localStorage.getItem(
            "kavrolinSettings"
        );

    if (!saved) {

        return JSON.parse(
            JSON.stringify(
                defaultSettings
            )
        );
    }

    try {

        const parsed =
            JSON.parse(saved);

        return {

            ...defaultSettings,

            ...parsed,

            schedule: {

                ...defaultSettings.schedule,

                ...(parsed.schedule || {})

            }

        };

    } catch {

        return JSON.parse(
            JSON.stringify(
                defaultSettings
            )
        );
    }
}


/* =========================================
   ПРИМЕНИТЬ НАСТРОЙКИ
========================================= */

function applySettings() {

    const settings =
        getSettings();


    /* TWITCH */

    document
        .getElementById("heroTwitch")
        .href =
        settings.twitch;

    document
        .getElementById("twitchButton")
        .href =
        settings.twitch;


    /* TELEGRAM */

    document
        .getElementById("heroTelegram")
        .href =
        settings.telegram;

    document
        .getElementById("telegramButton")
        .href =
        settings.telegram;


    /* DONATELLO */

    document
        .getElementById("donatelloButton")
        .href =
        settings.donatello;

    document
        .getElementById("donateMainButton")
        .href =
        settings.donatello;


    /* РАСПИСАНИЕ */

    document
        .querySelectorAll(
            ".day[data-day]"
        )
        .forEach(day => {

            const dayName =
                day.dataset.day;

            const time =
                settings.schedule[dayName];

            if (time) {

                day.querySelector("span")
                    .textContent =
                    time;
            }

        });
}


/* =========================================
   ОТКРЫТЬ ОКНО ПАРОЛЯ
========================================= */

function openPasswordModal() {

    document
        .getElementById(
            "passwordModal"
        )
        .classList
        .add("active");

    document
        .getElementById(
            "passwordInput"
        )
        .value = "";

    document
        .getElementById(
            "passwordError"
        )
        .textContent = "";

    setTimeout(() => {

        document
            .getElementById(
                "passwordInput"
            )
            .focus();

    }, 100);
}


/* =========================================
   ЗАКРЫТЬ ОКНО ПАРОЛЯ
========================================= */

function closePasswordModal() {

    document
        .getElementById(
            "passwordModal"
        )
        .classList
        .remove("active");
}


/* =========================================
   ПРОВЕРКА ПАРОЛЯ
========================================= */

function checkPassword() {

    const password =
        document
            .getElementById(
                "passwordInput"
            )
            .value;

    const error =
        document
            .getElementById(
                "passwordError"
            );


    if (
        password ===
        ADMIN_PASSWORD
    ) {

        closePasswordModal();

        openAdmin();

    } else {

        error.textContent =
            "❌ Неверный пароль";

    }
}


/* =========================================
   ОТКРЫТЬ АДМИНКУ
========================================= */

function openAdmin() {

    loadAdminData();

    document
        .getElementById(
            "adminModal"
        )
        .classList
        .add("active");
}


/* =========================================
   ЗАКРЫТЬ АДМИНКУ
========================================= */

function closeAdmin() {

    document
        .getElementById(
            "adminModal"
        )
        .classList
        .remove("active");
}


/* =========================================
   ЗАГРУЗИТЬ ДАННЫЕ В АДМИНКУ
========================================= */

function loadAdminData() {

    const settings =
        getSettings();


    document
        .getElementById(
            "adminTwitch"
        )
        .value =
        settings.twitch;


    document
        .getElementById(
            "adminTelegram"
        )
        .value =
        settings.telegram;


    document
        .getElementById(
            "adminDonatello"
        )
        .value =
        settings.donatello;


    document
        .getElementById(
            "adminMonday"
        )
        .value =
        settings.schedule[
            "ПОНЕДЕЛЬНИК"
        ];


    document
        .getElementById(
            "adminTuesday"
        )
        .value =
        settings.schedule[
            "ВТОРНИК"
        ];


    document
        .getElementById(
            "adminWednesday"
        )
        .value =
        settings.schedule[
            "СРЕДА"
        ];


    document
        .getElementById(
            "adminThursday"
        )
        .value =
        settings.schedule[
            "ЧЕТВЕРГ"
        ];


    document
        .getElementById(
            "adminFriday"
        )
        .value =
        settings.schedule[
            "ПЯТНИЦА"
        ];


    document
        .getElementById(
            "adminSaturday"
        )
        .value =
        settings.schedule[
            "СУББОТА"
        ];


    document
        .getElementById(
            "adminSunday"
        )
        .value =
        settings.schedule[
            "ВОСКРЕСЕНЬЕ"
        ];
}


/* =========================================
   СОХРАНИТЬ ИЗМЕНЕНИЯ
========================================= */

function saveChanges() {

    const settings =
        getSettings();


    /* ССЫЛКИ */

    settings.twitch =
        document
            .getElementById(
                "adminTwitch"
            )
            .value
            .trim();


    settings.telegram =
        document
            .getElementById(
                "adminTelegram"
            )
            .value
            .trim();


    settings.donatello =
        document
            .getElementById(
                "adminDonatello"
            )
            .value
            .trim();


    /* РАСПИСАНИЕ */

    settings.schedule[
        "ПОНЕДЕЛЬНИК"
    ] =
        document
            .getElementById(
                "adminMonday"
            )
            .value
            .trim();


    settings.schedule[
        "ВТОРНИК"
    ] =
        document
            .getElementById(
                "adminTuesday"
            )
            .value
            .trim();


    settings.schedule[
        "СРЕДА"
    ] =
        document
            .getElementById(
                "adminWednesday"
            )
            .value
            .trim();


    settings.schedule[
        "ЧЕТВЕРГ"
    ] =
        document
            .getElementById(
                "adminThursday"
            )
            .value
            .trim();


    settings.schedule[
        "ПЯТНИЦА"
    ] =
        document
            .getElementById(
                "adminFriday"
            )
            .value
            .trim();


    settings.schedule[
        "СУББОТА"
    ] =
        document
            .getElementById(
                "adminSaturday"
            )
            .value
            .trim();


    settings.schedule[
        "ВОСКРЕСЕНЬЕ"
    ] =
        document
            .getElementById(
                "adminSunday"
            )
            .value
            .trim();


    /* СОХРАНЕНИЕ */

    localStorage.setItem(

        "kavrolinSettings",

        JSON.stringify(
            settings
        )

    );


    /* ПРИМЕНЯЕМ */

    applySettings();


    document
        .getElementById(
            "adminStatus"
        )
        .textContent =
        "✅ Изменения успешно сохранены!";

}


/* =========================================
   СБРОСИТЬ РАСПИСАНИЕ
========================================= */

function resetSchedule() {

    if (
        !confirm(
            "Сбросить расписание к стандартному?"
        )
    ) {
        return;
    }


    const settings =
        getSettings();


    settings.schedule =
        JSON.parse(
            JSON.stringify(
                defaultSettings.schedule
            )
        );


    localStorage.setItem(

        "kavrolinSettings",

        JSON.stringify(
            settings
        )

    );


    applySettings();

    loadAdminData();


    document
        .getElementById(
            "adminStatus"
        )
        .textContent =
        "↩ Расписание сброшено.";
}


/* =========================================
   ENTER В ПОЛЕ ПАРОЛЯ
========================================= */

document
    .getElementById(
        "passwordInput"
    )
    .addEventListener(
        "keydown",
        function(event) {

            if (
                event.key ===
                "Enter"
            ) {

                checkPassword();

            }

        }
    );


/* =========================================
   ЗАКРЫТИЕ ПО КЛИКУ НА ФОН
========================================= */

document
    .getElementById(
        "passwordModal"
    )
    .addEventListener(
        "click",
        function(event) {

            if (
                event.target ===
                this
            ) {

                closePasswordModal();

            }

        }
    );


document
    .getElementById(
        "adminModal"
    )
    .addEventListener(
        "click",
        function(event) {

            if (
                event.target ===
                this
            ) {

                closeAdmin();

            }

        }
    );


/* =========================================
   ПРИ ЗАГРУЗКЕ
========================================= */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        applySettings();

    }
);

</script>

</body>
</html>
