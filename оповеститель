<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>KAVROLIN — официальный сайт</title>

    <meta name="description"
          content="KAVROLIN — Twitch, Telegram, донаты и весь движ в одном месте.">

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background:
                radial-gradient(
                    circle at 50% 0%,
                    rgba(130, 25, 25, .35),
                    transparent 35%
                ),
                #120706;

            color: #f7ead2;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* =========================================
           КОВРОВЫЙ ФОН
        ========================================= */

        body::before {
            content: "";
            position: fixed;
            inset: 0;

            z-index: -2;

            background:
                repeating-radial-gradient(
                    ellipse at center,
                    transparent 0 25px,
                    rgba(150, 70, 25, .18) 26px 28px
                ),

                repeating-linear-gradient(
                    45deg,
                    #32100d 0 12px,
                    #501813 12px 24px,
                    #24100d 24px 36px
                );

            opacity: .8;
        }

        body::after {
            content: "";
            position: fixed;
            inset: 0;

            z-index: -1;
            pointer-events: none;

            background:
                radial-gradient(
                    circle at center,
                    transparent 20%,
                    rgba(0,0,0,.75) 100%
                );
        }


        /* =========================================
           НАВИГАЦИЯ
        ========================================= */

        nav {
            position: fixed;

            top: 0;
            left: 0;
            right: 0;

            height: 70px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 6%;

            background: rgba(15, 5, 4, .88);

            backdrop-filter: blur(12px);

            border-bottom: 1px solid rgba(255, 205, 120, .25);

            z-index: 1000;
        }

        .logo {
            font-size: 25px;
            font-weight: 900;
            letter-spacing: 3px;

            color: #f0c77a;

            text-shadow:
                2px 2px 0 #54130f,
                0 0 15px rgba(240, 199, 122, .25);
        }

        nav .links {
            display: flex;
            align-items: center;
        }

        nav a {
            color: #f7ead2;

            text-decoration: none;

            margin-left: 25px;

            font-size: 14px;
            font-weight: bold;

            transition: .25s;
        }

        nav a:hover {
            color: #e8ad4e;
        }


        /* =========================================
           КНОПКА АДМИНИСТРАТОРА — КОВЁР
        ========================================= */

        .admin-carpet {
            margin-left: 22px;

            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            border: 1px solid #a96635;

            background:
                radial-gradient(
                    circle,
                    #7e2119,
                    #32100d
                );

            color: #f1cb82;

            font-size: 21px;

            cursor: pointer;

            box-shadow:
                0 0 12px rgba(210, 150, 70, .2);

            transition: .25s;
        }

        .admin-carpet:hover {
            transform: rotate(-8deg) scale(1.08);

            box-shadow:
                0 0 25px rgba(240, 190, 100, .4);
        }


        /* =========================================
           HERO
        ========================================= */

        .hero {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;

            padding: 120px 20px 80px;
        }

        .hero-content {
            max-width: 900px;
        }

        .tag {
            display: inline-block;

            padding: 8px 16px;

            margin-bottom: 20px;

            border: 1px solid #a66b35;

            border-radius: 100px;

            color: #e8c486;

            background: rgba(60, 15, 10, .7);

            font-size: 12px;

            letter-spacing: 2px;

            text-transform: uppercase;
        }

        h1 {
            font-size: clamp(55px, 11vw, 130px);

            line-height: .9;

            font-weight: 1000;

            letter-spacing: -5px;

            color: #eac17a;

            text-shadow:
                5px 5px 0 #53120f,
                9px 9px 0 rgba(0,0,0,.5);

            margin-bottom: 25px;
        }

        .hero p {
            max-width: 650px;

            margin: auto;

            font-size: 18px;

            line-height: 1.7;

            color: #e2cdb0;
        }

        .hero-buttons {
            display: flex;

            justify-content: center;

            flex-wrap: wrap;

            gap: 14px;

            margin-top: 35px;
        }


        /* =========================================
           КНОПКИ
        ========================================= */

        .btn {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-width: 170px;

            padding: 15px 25px;

            border-radius: 8px;

            color: #fff4dd;

            text-decoration: none;

            font-weight: 800;

            letter-spacing: .5px;

            background:
                linear-gradient(
                    135deg,
                    #7e2119,
                    #47100e
                );

            border: 1px solid #a96635;

            box-shadow:
                0 8px 25px rgba(0,0,0,.35),
                inset 0 0 20px rgba(255,180,80,.05);

            transition: .25s;

            cursor: pointer;
        }

        .btn:hover {
            transform: translateY(-4px);

            box-shadow:
                0 14px 30px rgba(0,0,0,.5),
                0 0 20px rgba(211,145,60,.2);
        }

        .btn-gold {
            color: #32100b;

            background:
                linear-gradient(
                    135deg,
                    #f1cb82,
                    #bd7a30
                );
        }


        /* =========================================
           ОБЩИЕ СЕКЦИИ
        ========================================= */

        section {
            padding: 90px 7%;
        }

        .section-title {
            text-align: center;

            margin-bottom: 50px;
        }

        .section-title span {
            color: #c58b47;

            font-size: 13px;

            text-transform: uppercase;

            letter-spacing: 3px;
        }

        .section-title h2 {
            margin-top: 10px;

            font-size: clamp(32px, 5vw, 55px);

            color: #f1d09a;

            text-shadow:
                3px 3px 0 #42100c;
        }


        /* =========================================
           СОЦСЕТИ
        ========================================= */

        .social-grid {
            max-width: 1100px;

            margin: auto;

            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 18px;
        }

        .social {
            position: relative;

            padding: 30px 20px;

            text-align: center;

            background:
                rgba(32, 9, 7, .88);

            border:
                1px solid rgba(220, 169, 91, .35);

            border-radius: 12px;

            text-decoration: none;

            color: #f6e7cb;

            overflow: hidden;

            transition: .3s;
        }

        .social:hover {
            transform: translateY(-8px);

            border-color: #d59b4c;
        }

        .social-icon {
            font-size: 38px;

            margin-bottom: 15px;
        }

        .social h3 {
            font-size: 20px;

            margin-bottom: 7px;
        }

        .social p {
            font-size: 13px;

            color: #bca98f;
        }


        /* =========================================
           РАСПИСАНИЕ
        ========================================= */

        .schedule {
            max-width: 850px;

            margin: auto;

            display: grid;

            gap: 12px;
        }

        .day {
            display: flex;

            justify-content: space-between;

            align-items: center;

            padding: 20px 25px;

            background:
                rgba(31, 8, 6, .9);

            border-left:
                4px solid #a75c28;

            border-radius: 7px;

            transition: .2s;
        }

        .day:hover {
            transform: translateX(5px);

            border-left-color: #e4b566;
        }

        .day strong {
            color: #f1d09a;
        }

        .day span {
            color: #c09b68;

            font-weight: bold;
        }


        /* =========================================
           КОНТЕНТ
        ========================================= */

        .cards {
            max-width: 1100px;

            margin: auto;

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 20px;
        }

        .card {
            padding: 30px;

            background:
                rgba(31, 8, 6, .9);

            border:
                1px solid rgba(214, 157, 78, .3);

            border-radius: 12px;
        }

        .card h3 {
            margin-bottom: 15px;

            color: #e9bd78;
        }

        .card p {
            line-height: 1.7;

            color: #c9b69a;

            font-size: 14px;
        }


        /* =========================================
           DONATE
        ========================================= */

        .donate {
            max-width: 900px;

            margin: auto;

            text-align: center;

            padding: 60px 30px;

            background:
                linear-gradient(
                    135deg,
                    rgba(93, 24, 17, .95),
                    rgba(35, 8, 6, .95)
                );

            border:
                1px solid #a96836;

            border-radius: 15px;

            box-shadow:
                0 20px 60px rgba(0,0,0,.45);
        }

        .donate h2 {
            font-size: 40px;

            color: #f3d194;

            margin-bottom: 15px;
        }

        .donate p {
            color: #d6c1a3;

            margin-bottom: 25px;
        }


        /* =========================================
           FOOTER
        ========================================= */

        footer {
            padding: 45px 20px;

            text-align: center;

            border-top:
                1px solid rgba(220, 170, 90, .2);

            color: #8e7962;

            font-size: 13px;
        }

        footer b {
            color: #c79a58;
        }


        /* =========================================
           АНИМАЦИЯ
        ========================================= */

        .fade {
            animation:
                fadeUp 1s ease both;
        }

        @keyframes fadeUp {

            from {
                opacity: 0;

                transform:
                    translateY(25px);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0);
            }
        }


        /* =========================================
           ОКНО ПАРОЛЯ
        ========================================= */

        .modal {
            position: fixed;

            inset: 0;

            z-index: 5000;

            display: none;

            align-items: center;
            justify-content: center;

            padding: 20px;

            background:
                rgba(0,0,0,.82);

            backdrop-filter:
                blur(10px);
        }

        .modal.active {
            display: flex;
        }

        .modal-box {
            width: min(420px, 100%);

            padding: 35px;

            background:
                linear-gradient(
                    145deg,
                    #3a100c,
                    #120504
                );

            border:
                1px solid #b77b35;

            border-radius: 15px;

            box-shadow:
                0 25px 80px rgba(0,0,0,.7);

            text-align: center;
        }

        .modal-carpet {
            font-size: 45px;

            margin-bottom: 10px;
        }

        .modal-box h2 {
            color: #f1d09a;

            margin-bottom: 10px;
        }

        .modal-box p {
            color: #bca98f;

            font-size: 14px;

            margin-bottom: 22px;
        }

        .password-input {
            width: 100%;

            padding: 15px;

            border-radius: 8px;

            border:
                1px solid #a96635;

            background:
                #170706;

            color: #fff4dd;

            outline: none;

            text-align: center;

            font-size: 18px;

            letter-spacing: 4px;
        }

        .password-input:focus {
            border-color: #e4b566;

            box-shadow:
                0 0 15px rgba(228,181,102,.15);
        }

        .modal-buttons {
            display: flex;

            gap: 10px;

            margin-top: 15px;
        }

        .modal-buttons .btn {
            width: 100%;

            min-width: 0;
        }

        .error {
            min-height: 20px;

            margin-top: 12px;

            color: #ef7770;

            font-size: 13px;
        }


        /* =========================================
           АДМИН-ПАНЕЛЬ
        ========================================= */

        .admin-modal-box {
            width: min(850px, 100%);

            max-height: 90vh;

            overflow-y: auto;

            padding: 30px;

            background:
                linear-gradient(
                    145deg,
                    #2b0b08,
                    #120504
                );

            border:
                1px solid #b77b35;

            border-radius: 15px;

            box-shadow:
                0 25px 80px rgba(0,0,0,.7);
        }

        .admin-header {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 25px;
        }

        .admin-header h2 {
            color: #f1d09a;
        }

        .close-admin {
            width: 40px;
            height: 40px;

            border: 1px solid #74452a;

            border-radius: 8px;

            background:
                #1a0705;

            color: #f1d09a;

            font-size: 24px;

            cursor: pointer;
        }

        .admin-section {
            margin-bottom: 30px;

            padding: 22px;

            background:
                rgba(0,0,0,.2);

            border:
                1px solid rgba(214,157,78,.2);

            border-radius: 12px;
        }

        .admin-section h3 {
            color: #e9bd78;

            margin-bottom: 18px;
        }

        .admin-grid {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 15px;
        }

        .admin-field {
            display: flex;

            flex-direction: column;

            gap: 7px;
        }

        .admin-field label {
            color: #c9b69a;

            font-size: 13px;

            font-weight: bold;
        }

        .admin-field input {
            width: 100%;

            padding: 12px 14px;

            border-radius: 7px;

            border:
                1px solid rgba(214,157,78,.4);

            background:
                #170706;

            color: #f7ead2;

            outline: none;
        }

        .admin-field input:focus {
            border-color: #e4b566;
        }

        .schedule-admin {
            display: grid;

            gap: 10px;
        }

        .schedule-admin-row {
            display: grid;

            grid-template-columns:
                180px 1fr;

            gap: 10px;

            align-items: center;
        }

        .schedule-admin-row strong {
            color: #f1d09a;
        }

        .admin-actions {
            display: flex;

            flex-wrap: wrap;

            gap: 10px;

            margin-top: 20px;
        }

        .admin-status {
            margin-top: 15px;

            min-height: 20px;

            color: #d9b878;

            font-size: 13px;
        }


        /* =========================================
           МОБИЛЬНЫЙ
        ========================================= */

        @media (max-width: 850px) {

            nav {
                padding: 0 20px;
            }

            nav .links a {
                display: none;
            }

            .social-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .cards {
                grid-template-columns:
                    1fr;
            }

            .admin-grid {
                grid-template-columns:
                    1fr;
            }
        }

        @media (max-width: 520px) {

            section {
                padding:
                    70px 20px;
            }

            .social-grid {
                grid-template-columns:
                    1fr;
            }

            .hero-buttons {
                flex-direction:
                    column;
            }

            .btn {
                width: 100%;
            }

            .day {
                padding: 17px;

                font-size: 14px;
            }

            .schedule-admin-row {
                grid-template-columns:
                    1fr;
            }

            .admin-modal-box {
                padding: 20px;
            }
        }

    </style>
</head>

<body>


